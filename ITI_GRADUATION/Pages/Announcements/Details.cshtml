@page "{id:int}"
@model ITI_GRADUATION.Pages.Announcements.DetailsModel

@{
    ViewData["Title"] = "Announcement Details";
    ViewData["BgImage"] = "https://images.unsplash.com/photo-1741636174186-3fffe1614c39?auto=format&fit=crop&w=1920&q=80";
}

<div class="nx-page-header">
    <div>
        <div class="nx-eyebrow">Company Board</div>
        <h2 class="mb-0">@Model.Announcement.Title</h2>
    </div>
    <div class="d-flex gap-2">
        <a asp-page="./Edit" asp-route-id="@Model.Announcement.Id" class="btn btn-nx-outline"><i class="fa-regular fa-pen-to-square me-1"></i> Edit</a>
        <a asp-page="./Index" class="btn btn-nx-outline"><i class="fa-solid fa-arrow-left me-1"></i> Back</a>
    </div>
</div>

<div class="nx-card" style="max-width: 720px;">
    <div class="nx-card-body">
        <div class="text-muted small mb-3">Posted on @Model.Announcement.PostedOn.ToString("dd MMMM yyyy, HH:mm")</div>
        <p style="white-space: pre-wrap;">@Model.Announcement.Message</p>
    </div>
</div>
