@page
@model ITI_GRADUATION.Pages.Announcements.CreateModel

@{
    ViewData["Title"] = "New Announcement";
    ViewData["BgImage"] = "https://images.unsplash.com/photo-1741636174186-3fffe1614c39?auto=format&fit=crop&w=1920&q=80";
}

<div class="nx-page-header">
    <div>
        <div class="nx-eyebrow">Company Board</div>
        <h2 class="mb-0">New Announcement</h2>
    </div>
    <a asp-page="./Index" class="btn btn-nx-outline"><i class="fa-solid fa-arrow-left me-1"></i> Back to list</a>
</div>

<div class="nx-card" style="max-width: 640px;">
    <div class="nx-card-body">
        <form method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Announcement.Title" class="nx-form-label"></label>
                <input asp-for="Announcement.Title" class="form-control" placeholder="e.g. Office closed on public holiday" />
                <span asp-validation-for="Announcement.Title" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Announcement.Message" class="nx-form-label"></label>
                <textarea asp-for="Announcement.Message" class="form-control" rows="5" placeholder="Write the announcement details…"></textarea>
                <span asp-validation-for="Announcement.Message" class="text-danger small"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-nx-primary"><i class="fa-solid fa-check me-1"></i> Post Announcement</button>
                <a asp-page="./Index" class="btn btn-nx-outline">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
