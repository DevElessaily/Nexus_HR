@model ITI_GRADUATION.Models.Employee

@{
    ViewData["Title"] = "Employee Details";
    ViewData["BgImage"] = "https://images.unsplash.com/photo-1758873269276-9518d0cb4a0b?auto=format&fit=crop&w=1920&q=80";
}

<div class="nx-page-header">
    <div>
        <div class="nx-eyebrow">Employees</div>
        <h2 class="mb-0">Employee Profile</h2>
    </div>
    <a asp-action="Index" class="btn btn-nx-outline"><i class="fa-solid fa-arrow-left me-1"></i> Back to list</a>
</div>

<div class="nx-card">
    <div class="nx-card-body">
        <div class="d-flex align-items-center gap-4 flex-wrap">
            @if (!string.IsNullOrEmpty(Model.ProfileImagePath))
            {
                <button type="button" class="nx-avatar-btn" onclick="openLightbox('@Model.ProfileImagePath')" title="Click to view full size">
                    <avatar name="@Model.FullName" image="@Model.ProfileImagePath" size="lg"></avatar>
                </button>
            }
            else
            {
                <avatar name="@Model.FullName" image="@Model.ProfileImagePath" size="lg"></avatar>
            }
            <div class="flex-grow-1">
                <h3 class="mb-1">@Model.FullName</h3>
                <span class="nx-badge">@(Model.Department?.Name ?? "No Department")</span>
                <span class="text-muted ms-2">@(Model.JobTitle?.Title ?? "No Job Title")</span>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-nx-outline"><i class="fa-regular fa-pen-to-square me-1"></i> Edit</a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-nx-danger"><i class="fa-regular fa-trash-can me-1"></i> Delete</a>
            </div>
        </div>

        <hr class="my-4" />

        <div class="row g-4">
            <div class="col-md-4">
                <div class="text-muted small mb-1">Email</div>
                <div class="fw-medium">@Model.Email</div>
            </div>
            <div class="col-md-4">
                <div class="text-muted small mb-1">Phone Number</div>
                <div class="fw-medium">@Model.PhoneNumber</div>
            </div>
            <div class="col-md-4">
                <div class="text-muted small mb-1">Hire Date</div>
                <div class="fw-medium">@Model.HireDate.ToString("dd MMMM yyyy")</div>
            </div>
            <div class="col-md-4">
                <div class="text-muted small mb-1">Department</div>
                <div class="fw-medium">@(Model.Department?.Name ?? "—")</div>
            </div>
            <div class="col-md-4">
                <div class="text-muted small mb-1">Job Title</div>
                <div class="fw-medium">@(Model.JobTitle?.Title ?? "—")</div>
            </div>
            <div class="col-md-4">
                <div class="text-muted small mb-1">Salary</div>
                <div class="fw-medium">@Model.Salary.ToString("C")</div>
            </div>
        </div>
    </div>
</div>
