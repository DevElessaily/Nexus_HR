@model ITI_GRADUATION.Models.Department

@{
    ViewData["Title"] = "Department Details";
    ViewData["BgImage"] = "https://images.unsplash.com/photo-1745015446589-7ee6f702d8c1?auto=format&fit=crop&w=1920&q=80";
}

<div class="nx-page-header">
    <div>
        <div class="nx-eyebrow">Departments</div>
        <h2 class="mb-0">@Model.Name</h2>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-nx-outline"><i class="fa-regular fa-pen-to-square me-1"></i> Edit</a>
        <a asp-action="Index" class="btn btn-nx-outline"><i class="fa-solid fa-arrow-left me-1"></i> Back</a>
    </div>
</div>

<div class="nx-card">
    <div class="nx-card-body">
        <h5 class="mb-3">Employees in this department (@(Model.Employees?.Count ?? 0))</h5>

        @if (Model.Employees != null && Model.Employees.Any())
        {
            <div class="table-responsive">
                <table class="table nx-table mb-0">
                    <thead>
                        <tr>
                            <th>Employee</th>
                            <th>Email</th>
                            <th>Hire Date</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var emp in Model.Employees)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <avatar name="@emp.FullName" image="@emp.ProfileImagePath"></avatar>
                                        <span class="fw-semibold">@emp.FullName</span>
                                    </div>
                                </td>
                                <td>@emp.Email</td>
                                <td>@emp.HireDate.ToString("dd MMM yyyy")</td>
                                <td class="text-end">
                                    <a asp-controller="Employee" asp-action="Details" asp-route-id="@emp.Id" class="btn btn-sm btn-nx-outline">View</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="nx-empty">
                <i class="fa-solid fa-user-slash"></i>
                <p class="mb-0">No employees assigned to this department yet.</p>
            </div>
        }
    </div>
</div>
