@model IEnumerable<ITI_GRADUATION.Models.Department>

@{
    ViewData["Title"] = "Departments";
    ViewData["BgImage"] = "https://images.unsplash.com/photo-1745015446589-7ee6f702d8c1?auto=format&fit=crop&w=1920&q=80";
}

<div class="nx-page-header">
    <div>
        <div class="nx-eyebrow">Organization</div>
        <h2 class="mb-1">Departments</h2>
        <p class="text-muted mb-0">@Model.Count() department(s)</p>
    </div>
    <a asp-action="Create" class="btn btn-nx-primary"><i class="fa-solid fa-plus me-1"></i> Add Department</a>
</div>

<div class="nx-card">
    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table nx-table mb-0">
                <thead>
                    <tr>
                        <th>Department</th>
                        <th>Employees</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var dept in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@dept.Name</td>
                            <td><span class="nx-badge">@(dept.Employees?.Count ?? 0) employee(s)</span></td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@dept.Id" class="btn btn-sm btn-nx-outline" title="Details"><i class="fa-regular fa-eye"></i></a>
                                <a asp-action="Edit" asp-route-id="@dept.Id" class="btn btn-sm btn-nx-outline" title="Edit"><i class="fa-regular fa-pen-to-square"></i></a>
                                <a asp-action="Delete" asp-route-id="@dept.Id" class="btn btn-sm btn-nx-outline text-danger" title="Delete"><i class="fa-regular fa-trash-can"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="nx-empty">
            <i class="fa-solid fa-building"></i>
            <p class="mb-3">No departments yet.</p>
            <a asp-action="Create" class="btn btn-nx-primary">Add Department</a>
        </div>
    }
</div>
